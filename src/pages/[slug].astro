---
import MainLayout from '../layouts/Layout.astro';
import packagesData from '../data/singlepackage.json';
import siteSettingsData from '../data/siteSettings.json';

const { slug } = Astro.params;
const settings = siteSettingsData;

const packageInfo = packagesData.find((pkg) => pkg.slug === slug);

if (!packageInfo) {
  return Astro.redirect('/');
}
---

<MainLayout
  title={`${packageInfo.title} - Bali Adventure Explorer`}
  description={`Detail itinerary dan fasilitas untuk paket ${packageInfo.title}`}
  image={packageInfo.image}
>
  <section class="pt-32 pb-16 px-4 bg-gray-50">
    <div class="container mx-auto max-w-5xl">
      <div class="mb-6">
        <a href="/#package" class="inline-flex items-center text-gray-500 hover:text-emerald-600 transition font-medium">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to Packages
        </a>
      </div>

      <div class="bg-white rounded-2xl shadow-xl overflow-hidden flex flex-col md:flex-row">
        <div class="md:w-1/2 h-64 md:h-auto relative group">
          <img src={packageInfo.image} alt={packageInfo.title} class="w-full h-full object-cover transition duration-500 group-hover:scale-105" />
          <div class="absolute top-4 left-4 bg-red-500 text-white font-bold px-4 py-1 rounded-full text-sm shadow-md">Promo</div>
        </div>
        
        <div class="md:w-1/2 p-8 flex flex-col justify-center">
          <h1 class="text-3xl font-bold text-gray-800 mb-2">{packageInfo.title}</h1>
          <div class="w-16 h-1 bg-emerald-500 mb-4 rounded-full"></div>
          
          <div class="flex items-center gap-4 mb-6 pb-6 border-b border-gray-100">
            <span class="text-gray-400 line-through text-lg">{packageInfo.originalPrice}</span>
            <span class="text-3xl font-bold text-emerald-600">{packageInfo.discountedPrice}</span>
          </div>
          
          <h3 class="font-bold text-gray-700 mb-4">Secure Your Spot:</h3>
          
          <form 
            id="wa-booking-form" 
            class="space-y-4"
            data-pkgtitle={packageInfo.title}
            data-wanumber={settings.whatsappNumber}
          >
            <div>
              <input type="text" id="book-name" required placeholder="Full Name" class="w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-lg focus:ring-2 focus:ring-emerald-500 outline-none transition" />
            </div>
            <div class="flex gap-4">
              <div class="w-1/2">
                <input type="date" id="book-date" required class="w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-lg focus:ring-2 focus:ring-emerald-500 outline-none transition text-gray-600" />
              </div>
              <div class="w-1/2">
                <input type="number" id="book-pax" min="1" required placeholder="Pax" class="w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-lg focus:ring-2 focus:ring-emerald-500 outline-none transition" />
              </div>
            </div>
            <div>
              <textarea id="book-notes" rows="2" placeholder="Special Request (Optional)" class="w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-lg focus:ring-2 focus:ring-emerald-500 outline-none transition"></textarea>
            </div>
            <button type="submit" class="w-full bg-orange-500 hover:bg-orange-600 text-white font-bold py-3 px-4 rounded-lg transition shadow-md flex justify-center items-center gap-2 mt-2">
              Send Booking via WhatsApp
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <section class="py-12 px-4 bg-white mb-12">
    <div class="container mx-auto max-w-5xl grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="bg-gray-50 p-8 rounded-xl border border-gray-100">
        <h3 class="text-xl font-bold text-gray-800 mb-6 border-b border-gray-200 pb-3">Details</h3>
        <ul class="space-y-4">
          {packageInfo.details?.map((item) => <li class="flex items-start text-gray-700"><span class="text-emerald-500 mr-3">✔</span> {item}</li>)}
        </ul>
      </div>
      <div class="bg-gray-50 p-8 rounded-xl border border-gray-100">
        <h3 class="text-xl font-bold text-gray-800 mb-6 border-b border-gray-200 pb-3">Itinerary</h3>
        <ul class="space-y-4 relative before:absolute before:ml-2 before:h-full before:w-0.5 before:bg-gray-300">
          {packageInfo.itinerary?.map((item) => (
            <li class="flex items-start text-gray-700 relative">
              <span class="bg-orange-500 w-2 h-2 rounded-full absolute left-[5px] mt-2"></span>
              <span class="pl-6">{item}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="bg-gray-50 p-8 rounded-xl border border-gray-100">
        <h3 class="text-xl font-bold text-gray-800 mb-6 border-b border-gray-200 pb-3">Bring</h3>
        <ul class="space-y-4">
          {packageInfo.whatToBring?.map((item) => <li class="flex items-start text-gray-700"><span class="text-blue-500 mr-3">⇨</span> {item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('wa-booking-form') as HTMLFormElement | null;
      
      if (form) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          
          const nameInput = document.getElementById('book-name') as HTMLInputElement | null;
          const dateInput = document.getElementById('book-date') as HTMLInputElement | null;
          const paxInput = document.getElementById('book-pax') as HTMLInputElement | null;
          const notesInput = document.getElementById('book-notes') as HTMLTextAreaElement | null;
          
          const name = nameInput?.value || '';
          const date = dateInput?.value || '';
          const pax = paxInput?.value || '';
          const notes = notesInput?.value || '-';
          
          const pkgTitle = form.dataset.pkgtitle || 'Paket Tour';
          let waNumber = form.dataset.wanumber || '';
          waNumber = waNumber.replace(/[^0-9]/g, ''); 

          const message = `Hello Bali Adventure Explorer!%0AI would like to book a tour:%0A%0A📦 *Package:* ${pkgTitle}%0A👤 *Name:* ${name}%0A📅 *Date:* ${date}%0A👥 *Participants:* ${pax} Pax%0A📝 *Notes:* ${notes}%0A%0APlease let me know the availability. Thank you!`;
          
          window.open(`https://wa.me/${waNumber}?text=${message}`, '_blank');
        });
      }
    });
  </script>
</MainLayout>