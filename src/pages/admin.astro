---
// src/pages/admin.astro
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <title>Admin Dashboard - Bali Explorer</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Tailwind CSS Play CDN versi aman -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>
  <body class="flex h-screen bg-slate-50 text-slate-800 overflow-hidden font-sans">
    
    <!-- Sidebar -->
    <aside class="w-64 bg-slate-900 text-white flex flex-col z-10 shadow-xl">
      <div class="p-6 border-b border-slate-800 text-xl font-bold tracking-wide flex items-center gap-2">
        <span>⚡</span> Admin Panel
      </div>
      <nav id="sidebar-nav" class="flex-1 p-4 flex flex-col gap-2 overflow-y-auto">
        <button data-tab="packages" class="w-full text-left px-4 py-2.5 rounded-lg bg-emerald-600 text-white font-semibold transition shadow-sm">📦 Tour Packages</button>
        <button data-tab="settings" class="w-full text-left px-4 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white transition">⚙️ Settings</button>
        <button data-tab="gallery" class="w-full text-left px-4 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white transition">🖼️ Gallery</button>
        <button data-tab="faq" class="w-full text-left px-4 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white transition">❓ FAQ</button>
        <button data-tab="testimonials" class="w-full text-left px-4 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white transition">💬 Testimonials</button>
        <button data-tab="about" class="w-full text-left px-4 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white transition">ℹ️ About Us</button>
      </nav>
      <div class="p-4 border-t border-slate-800">
        <a href="../" class="block text-center py-2.5 bg-red-600 hover:bg-red-700 text-white rounded-lg font-semibold text-sm transition shadow">Kembali ke Website</a>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col overflow-hidden bg-slate-100">
      <header class="bg-white px-8 py-4 flex justify-between items-center border-b border-slate-200 shadow-sm">
        <h2 id="page-title" class="text-xl font-bold text-slate-700">Manage Tour Packages</h2>
        <div class="flex items-center gap-4">
          <button id="btn-add" style="display:none;" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold rounded-lg shadow transition">+ Add New</button>
          <input type="password" id="github-token" placeholder="GitHub Token (ghp_...)" class="border border-slate-300 rounded-lg px-3 py-2 text-sm w-64 focus:ring-2 focus:ring-emerald-500 outline-none transition" />
        </div>
      </header>
      
      <div class="flex-1 overflow-y-auto p-8 flex flex-col gap-6 pb-28">
        <div id="status-msg" class="hidden p-4 rounded-lg text-sm font-medium"></div>
        <div id="form-container" class="flex flex-col gap-4">
          <p class="text-slate-500 italic">Memuat data terbaru langsung dari GitHub...</p>
        </div>
        
        <div class="fixed bottom-0 right-0 w-[calc(100%-16rem)] bg-white/90 backdrop-blur-md px-8 py-4 border-t border-slate-200 flex justify-end shadow-lg z-20">
          <button id="btn-save" class="px-6 py-2.5 bg-blue-600 hover:bg-blue-700 disabled:bg-slate-400 text-white font-semibold rounded-lg shadow-md transition flex items-center gap-2 cursor-pointer">💾 Simpan Perubahan ke GitHub</button>
        </div>
      </div>
    </main>

    <script>
      const tabs = document.querySelectorAll('#sidebar-nav button') as NodeListOf<HTMLButtonElement>;
      const pageTitle = document.getElementById('page-title') as HTMLHeadingElement;
      const formContainer = document.getElementById('form-container') as HTMLDivElement;
      const btnSave = document.getElementById('btn-save') as HTMLButtonElement;
      const btnAdd = document.getElementById('btn-add') as HTMLButtonElement;
      const tokenInput = document.getElementById('github-token') as HTMLInputElement;
      const statusMsg = document.getElementById('status-msg') as HTMLDivElement;

      let currentTab = 'packages';
      let currentData: any = null;
      let currentSha: string = '';

      const githubOwner = 'adiarthaputra';
      const githubRepo = 'jayaprana_adventure';

      if (localStorage.getItem('gh_token')) {
        tokenInput.value = localStorage.getItem('gh_token') || '';
      }
      tokenInput.addEventListener('input', (e: Event) => {
        const target = e.target as HTMLInputElement;
        localStorage.setItem('gh_token', target.value);
      });

      function showStatus(message: string, type: 'success' | 'error' = 'success') {
        statusMsg.textContent = message;
        statusMsg.className = type === 'success' 
          ? 'p-4 rounded-lg text-sm font-medium bg-emerald-100 text-emerald-800 border border-emerald-200 block' 
          : 'p-4 rounded-lg text-sm font-medium bg-rose-100 text-rose-800 border border-rose-200 block';
        setTimeout(() => { statusMsg.className = 'hidden'; statusMsg.textContent = ''; }, 6000);
      }

      function renderForm(data: any) {
        formContainer.innerHTML = '';
        currentData = data;

        if (Array.isArray(data)) {
          btnAdd.style.display = 'block';
        } else {
          btnAdd.style.display = 'none';
        }

        if (Array.isArray(data)) {
          if (data.length === 0) {
            formContainer.innerHTML = '<p class="text-slate-500 italic">Belum ada item. Klik "+ Add New" di atas.</p>';
            return;
          }

          data.forEach((item, index) => {
            const card = document.createElement('div');
            card.className = 'bg-white p-6 rounded-xl border border-slate-200 shadow-sm mb-4';
            
            const headerCard = document.createElement('div');
            headerCard.className = 'flex justify-between items-center mb-4 pb-3 border-b border-slate-100';
            
            const identifier = item.title || item.question || item.name || item.alt || `Item #${index + 1}`;
            headerCard.innerHTML = `<h3 class="font-bold text-slate-700 text-lg">${identifier}</h3>`;
            
            const btnDelete = document.createElement('button');
            btnDelete.textContent = '🗑️ Hapus Item';
            btnDelete.className = 'px-3 py-1 bg-rose-50 hover:bg-rose-100 text-rose-600 text-xs font-bold rounded transition cursor-pointer';
            btnDelete.onclick = () => {
              if (confirm(`Yakin ingin menghapus item ini?`)) {
                currentData.splice(index, 1);
                renderForm(currentData);
                showStatus('Item dihapus dari draf. Klik "Simpan" untuk menerapkan!', 'success');
              }
            };
            headerCard.appendChild(btnDelete);
            card.appendChild(headerCard);
            
            const grid = document.createElement('div');
            grid.className = 'grid grid-cols-1 md:grid-cols-2 gap-4';

            for (const key in item) {
              if (key === 'packages') continue;

              const wrap = document.createElement('div');
              const isFullWidth = key === 'description' || key === 'text' || key === 'image' || key === 'url' || key.toLowerCase().includes('url') || Array.isArray(item[key]);
              wrap.className = isFullWidth ? 'col-span-1 md:col-span-2 flex flex-col gap-1.5' : 'flex flex-col gap-1.5';

              const label = document.createElement('label');
              label.className = 'text-xs font-bold text-slate-500 uppercase tracking-wider';
              label.textContent = key === 'slug' ? 'Slug (Contoh: tour-baru tanpa spasi)' : key;

              let input: any;

              if (Array.isArray(item[key])) {
                input = document.createElement('textarea');
                input.className = 'w-full border border-slate-300 rounded-lg p-3 text-sm font-mono focus:ring-2 focus:ring-emerald-500 outline-none transition';
                input.value = item[key].join('\n');
                
                input.addEventListener('input', (e: Event) => {
                  const target = e.target as HTMLTextAreaElement;
                  currentData[index][key] = target.value.split('\n');
                });
              } else if (typeof item[key] === 'string' && (item[key].length > 50 || key === 'description' || key === 'text')) {
                input = document.createElement('textarea');
                input.className = 'w-full border border-slate-300 rounded-lg p-3 text-sm focus:ring-2 focus:ring-emerald-500 outline-none transition min-h-[100px]';
                input.value = item[key];
                
                input.addEventListener('input', (e: Event) => {
                  const target = e.target as HTMLTextAreaElement;
                  currentData[index][key] = target.value;
                });
              } else {
                input = document.createElement('input');
                input.type = typeof item[key] === 'number' ? 'number' : 'text';
                input.className = 'w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-emerald-500 outline-none transition';
                input.value = item[key];

                input.addEventListener('input', (e: Event) => {
                  const target = e.target as HTMLInputElement;
                  let val: any = target.value;
                  if (input.type === 'number') val = Number(val);
                  currentData[index][key] = val;

                  if (currentTab === 'packages' && key === 'slug') {
                    currentData[index]['moreInfoUrl'] = `/${val}`;
                  }
                });
              }

              wrap.appendChild(label);
              wrap.appendChild(input);
              
              if (key === 'image' || key === 'url' || key.toLowerCase().includes('url')) {
                 const preview = document.createElement('img');
                 preview.src = item[key];
                 preview.className = 'mt-2 h-24 w-auto rounded-lg object-cover border border-slate-300 shadow-sm';
                 preview.onerror = () => preview.style.display = 'none';
                 wrap.appendChild(preview);
                 
                 input.addEventListener('input', (e: Event) => {
                    const target = e.target as HTMLInputElement;
                    preview.src = target.value;
                    preview.style.display = 'block';
                 });
              }

              grid.appendChild(wrap);
            }
            card.appendChild(grid);
            formContainer.appendChild(card);
          });
        } else {
          // Object tunggal (Settings & About)
          const card = document.createElement('div');
          card.className = 'bg-white p-6 rounded-xl border border-slate-200 shadow-sm mb-4';
          const grid = document.createElement('div');
          grid.className = 'grid grid-cols-1 md:grid-cols-2 gap-4';

          for (const key in data) {
            const wrap = document.createElement('div');
            const isFullWidth = key === 'description' || key === 'subtitle' || key === 'image' || key === 'url' || key === 'heroSubtitle';
            wrap.className = isFullWidth ? 'col-span-1 md:col-span-2 flex flex-col gap-1.5' : 'flex flex-col gap-1.5';

            const label = document.createElement('label');
            label.className = 'text-xs font-bold text-slate-500 uppercase tracking-wider';
            label.textContent = key;

            let input: any;
            if (Array.isArray(data[key])) {
              input = document.createElement('textarea');
              input.className = 'w-full border border-slate-300 rounded-lg p-3 text-sm font-mono focus:ring-2 focus:ring-emerald-500 outline-none transition';
              input.value = data[key].join('\n');
              input.addEventListener('input', (e: Event) => {
                const target = e.target as HTMLTextAreaElement;
                currentData[key] = target.value.split('\n');
              });
            } else if (typeof data[key] === 'string' && data[key].length > 50) {
              input = document.createElement('textarea');
              input.className = 'w-full border border-slate-300 rounded-lg p-3 text-sm focus:ring-2 focus:ring-emerald-500 outline-none transition min-h-[100px]';
              input.value = data[key];
              input.addEventListener('input', (e: Event) => {
                const target = e.target as HTMLTextAreaElement;
                currentData[key] = target.value;
              });
            } else {
              input = document.createElement('input');
              input.type = typeof data[key] === 'number' ? 'number' : 'text';
              input.className = 'w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-emerald-500 outline-none transition';
              input.value = data[key];
              input.addEventListener('input', (e: Event) => {
                const target = e.target as HTMLInputElement;
                let val: any = target.value;
                if (input.type === 'number') val = Number(val);
                currentData[key] = val;
              });
            }

            wrap.appendChild(label);
            wrap.appendChild(input);

            if (key === 'image' || key === 'url' || key.toLowerCase().includes('url')) {
               const preview = document.createElement('img');
               preview.src = data[key];
               preview.className = 'mt-2 h-24 w-auto rounded-lg object-cover border border-slate-300 shadow-sm';
               preview.onerror = () => preview.style.display = 'none';
               wrap.appendChild(preview);
               
               input.addEventListener('input', (e: Event) => {
                  const target = e.target as HTMLInputElement;
                  preview.src = target.value;
                  preview.style.display = 'block';
               });
            }

            grid.appendChild(wrap);
          }
          card.appendChild(grid);
          formContainer.appendChild(card);
        }
      }

      btnAdd.addEventListener('click', () => {
        if (!Array.isArray(currentData)) return;

        if (currentTab === 'packages') {
          const newPackage = {
            slug: "paket-wisata-baru",
            title: "PAKET WISATA BARU",
            image: "https://images.unsplash.com/photo-1541625602330-2277a4c46182?q=80&w=800&auto=format&fit=crop",
            itinerary: ["08:00 - Penjemputan di hotel"],
            whatToBring: ["Pakaian ganti"],
            moreInfoUrl: "/paket-wisata-baru",
            packages: [
              {
                type: "Single",
                originalPrice: "IDR 500K",
                discountedPrice: "350K",
                details: ["Fasilitas 1 orang"],
                bookNowUrl: "https://wa.me/6281337626262"
              }
            ]
          };
          currentData.push(newPackage);
        } else if (currentTab === 'gallery') {
          currentData.push({ id: Date.now(), url: "https://images.unsplash.com/...", alt: "Foto baru" });
        } else {
          if (currentData.length === 0) {
            currentData.push({ title: "Item Baru", description: "Deskripsi..." });
          } else {
            const template = JSON.parse(JSON.stringify(currentData[0]));
            for (const key in template) {
              if (typeof template[key] === 'string') template[key] = 'Teks baru...';
              else if (typeof template[key] === 'number') template[key] = 0;
              else if (Array.isArray(template[key])) template[key] = ['Poin 1'];
            }
            currentData.push(template);
          }
        }

        renderForm(currentData);
        showStatus('Item baru berhasil ditambahkan! Jangan lupa klik Simpan.', 'success');
      });

      async function loadData(tab: string) {
        currentTab = tab;
        pageTitle.textContent = `Manage ${tab.charAt(0).toUpperCase() + tab.slice(1)}`;
        formContainer.innerHTML = '<p class="text-slate-500 italic">Memuat data terbaru langsung dari GitHub...</p>';
        btnSave.disabled = true;
        
        let targetFileJson = tab;
        if (tab === 'packages') targetFileJson = 'singlepackage';
        if (tab === 'settings') targetFileJson = 'siteSettings';

        const filePath = `src/data/${targetFileJson}.json`;
        const apiUrl = `https://api.github.com/repos/${githubOwner}/${githubRepo}/contents/${filePath}`;
        const token = tokenInput.value;

        try {
          const headers: any = {};
          if (token) headers['Authorization'] = `token ${token}`;

          const res = await fetch(apiUrl, { headers });
          if (!res.ok) throw new Error('Gagal mengambil data dari GitHub API. Cek token jika repository privat.');
          
          const fileData = await res.json();
          currentSha = fileData.sha;

          const jsonString = decodeURIComponent(escape(atob(fileData.content)));
          const data = JSON.parse(jsonString);

          renderForm(data);
        } catch (err: any) {
          formContainer.innerHTML = `<p class="text-rose-600 font-medium">Gagal memuat data: ${err.message}. Pastikan token GitHub terisi dengan benar di kanan atas.</p>`;
        } finally {
          btnSave.disabled = false;
        }
      }

      tabs.forEach(btn => {
        btn.addEventListener('click', (e: Event) => {
          tabs.forEach(t => {
            t.className = 'w-full text-left px-4 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white transition';
          });
          const target = e.target as HTMLButtonElement;
          target.className = 'w-full text-left px-4 py-2.5 rounded-lg bg-emerald-600 text-white font-semibold transition shadow-sm';
          
          if (target.dataset.tab) {
            loadData(target.dataset.tab);
          }
        });
      });

      btnSave.addEventListener('click', async () => {
        const token = tokenInput.value;
        if (!token) return showStatus('Error: Token GitHub wajib diisi untuk menyimpan!', 'error');
        if (!currentData) return showStatus('Data masih kosong.', 'error');

        btnSave.textContent = "⏳ Menyimpan ke GitHub...";
        btnSave.disabled = true;

        let targetFileJson = currentTab;
        if (currentTab === 'packages') targetFileJson = 'singlepackage';
        if (currentTab === 'settings') targetFileJson = 'siteSettings';

        const filePath = `src/data/${targetFileJson}.json`; 
        const apiUrl = `https://api.github.com/repos/${githubOwner}/${githubRepo}/contents/${filePath}`;

        try {
          const jsonString = JSON.stringify(currentData, null, 2);
          const base64Content = btoa(unescape(encodeURIComponent(jsonString)));

          const putRes = await fetch(apiUrl, {
            method: 'PUT',
            headers: {
              'Authorization': `token ${token}`,
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              message: `Update ${currentTab} via Admin Dashboard`,
              content: base64Content,
              sha: currentSha
            })
          });

          if (!putRes.ok) {
            const errData = await putRes.json();
            throw new Error(errData.message || 'Gagal menyimpan file.');
          }

          const resNew = await fetch(apiUrl, { headers: { 'Authorization': `token ${token}` } });
          if (resNew.ok) {
            const newData = await resNew.json();
            currentSha = newData.sha;
          }

          showStatus(`Sukses! Data ${currentTab} berhasil disimpan ke GitHub.`, 'success');

        } catch (err: any) { 
          showStatus(err.message, 'error');
        } finally {
          btnSave.textContent = "💾 Simpan Perubahan ke GitHub";
          btnSave.disabled = false;
        }
      });

      loadData(currentTab);
    </script>
  </body>
</html>