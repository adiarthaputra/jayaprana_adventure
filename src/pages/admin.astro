---
// src/pages/admin.astro
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <title>Admin Dashboard - Bali Explorer</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-gray-50 flex h-screen font-sans">
    
    <!-- Sidebar -->
    <aside class="w-64 bg-slate-800 text-white flex flex-col shadow-lg z-10">
      <div class="p-6 border-b border-slate-700">
        <h1 class="text-xl font-bold">Admin Panel</h1>
      </div>
      <nav class="flex-1 px-4 py-4 space-y-2" id="sidebar-nav">
        <button data-tab="packages" class="w-full text-left px-4 py-2 rounded bg-emerald-600 text-white tab-btn transition-colors font-semibold">📦 Tour Packages</button>
        <button data-tab="settings" class="w-full text-left px-4 py-2 rounded hover:bg-slate-700 tab-btn transition-colors">⚙️ Settings</button>
        <button data-tab="gallery" class="w-full text-left px-4 py-2 rounded hover:bg-slate-700 tab-btn transition-colors">🖼️ Gallery</button>
        <button data-tab="faq" class="w-full text-left px-4 py-2 rounded hover:bg-slate-700 tab-btn transition-colors">❓ FAQ</button>
        <button data-tab="testimonials" class="w-full text-left px-4 py-2 rounded hover:bg-slate-700 tab-btn transition-colors">💬 Testimonials</button>
        <button data-tab="about" class="w-full text-left px-4 py-2 rounded hover:bg-slate-700 tab-btn transition-colors">ℹ️ About Us</button>
      </nav>
      <div class="p-4 border-t border-slate-700">
        <a href="../" class="block text-center w-full py-2 bg-red-600 hover:bg-red-700 rounded text-white text-sm font-semibold transition-colors">Kembali ke Website</a>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col overflow-hidden bg-gray-100">
      <header class="bg-white shadow-sm px-6 py-4 flex justify-between items-center border-b border-gray-200">
        <h2 class="text-2xl font-semibold text-gray-800" id="page-title">Manage Tour Packages</h2>
        <div class="flex items-center gap-4">
          <button id="btn-add" class="hidden px-4 py-2 bg-emerald-600 text-white rounded-lg hover:bg-emerald-700 transition-colors text-sm font-semibold shadow-sm">+ Add New</button>
          <input type="password" id="github-token" placeholder="GitHub Token (ghp_...)" class="border border-gray-300 rounded-lg px-4 py-2 text-sm w-64 focus:ring-2 focus:ring-emerald-500 outline-none" />
        </div>
      </header>
      
      <div class="flex-1 overflow-auto p-6 flex flex-col gap-4">
        <!-- Notifikasi -->
        <div id="status-msg" class="hidden p-4 rounded-lg font-medium text-sm transition-all shadow-sm"></div>
        
        <!-- Wadah untuk Form Input -->
        <div id="form-container" class="flex-1 overflow-auto space-y-6 pb-20">
          <p class="text-gray-500">Memuat form...</p>
        </div>
        
        <!-- Tombol Simpan -->
        <div class="fixed bottom-0 right-0 bg-white w-[calc(100%-16rem)] p-4 border-t shadow-[0_-4px_6px_-1px_rgba(0,0,0,0.05)] flex justify-end">
          <button id="btn-save" class="px-8 py-2.5 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-semibold shadow-md">💾 Simpan Perubahan ke GitHub</button>
        </div>
      </div>
    </main>

    <script>
      const tabs = document.querySelectorAll('.tab-btn') as NodeListOf<HTMLButtonElement>;
      const pageTitle = document.getElementById('page-title') as HTMLHeadingElement;
      const formContainer = document.getElementById('form-container') as HTMLDivElement;
      const btnSave = document.getElementById('btn-save') as HTMLButtonElement;
      const btnAdd = document.getElementById('btn-add') as HTMLButtonElement;
      const tokenInput = document.getElementById('github-token') as HTMLInputElement;
      const statusMsg = document.getElementById('status-msg') as HTMLDivElement;

      let currentTab = 'packages';
      let currentData: any = null;

      const githubOwner = 'adiarthaputra';
      const githubRepo = 'jayaprana_adventure';

      if (localStorage.getItem('gh_token')) {
        tokenInput.value = localStorage.getItem('gh_token') || '';
      }
      tokenInput.addEventListener('input', (e: Event) => {
        const target = e.target as HTMLInputElement;
        localStorage.setItem('gh_token', target.value);
      });

      function showStatus(message: string, type: 'success' | 'error' = 'success') {
        statusMsg.textContent = message;
        statusMsg.className = `p-4 rounded-lg mb-4 text-sm ${
          type === 'success' ? 'bg-green-100 text-green-800 border border-green-200' : 'bg-red-100 text-red-800 border border-red-200'
        }`;
        statusMsg.classList.remove('hidden');
        setTimeout(() => statusMsg.classList.add('hidden'), 6000);
      }

      function renderForm(data: any) {
        formContainer.innerHTML = '';
        currentData = data;

        if (Array.isArray(data)) {
          btnAdd.classList.remove('hidden');
        } else {
          btnAdd.classList.add('hidden');
        }

        if (Array.isArray(data)) {
          if (data.length === 0) {
            formContainer.innerHTML = '<p class="text-gray-500 italic">Belum ada item. Klik "+ Add New" di atas.</p>';
            return;
          }

          data.forEach((item, index) => {
            const card = document.createElement('div');
            card.className = 'bg-white p-6 rounded-xl shadow-sm border border-gray-200 relative mb-4';
            
            const headerCard = document.createElement('div');
            headerCard.className = 'flex justify-between items-center mb-4 pb-2 border-b';
            
            const identifier = item.title || item.question || item.name || item.alt || `Item #${index + 1}`;
            headerCard.innerHTML = `<h3 class="font-bold text-lg text-gray-700">${identifier}</h3>`;
            
            const btnDelete = document.createElement('button');
            btnDelete.textContent = '🗑️ Hapus Item';
            btnDelete.className = 'px-3 py-1 bg-red-100 text-red-600 rounded hover:bg-red-200 text-xs font-semibold transition-colors';
            btnDelete.onclick = () => {
              if (confirm(`Yakin ingin menghapus item ini?`)) {
                currentData.splice(index, 1);
                renderForm(currentData);
                showStatus('Item dihapus dari draf. Klik "Simpan" untuk menerapkan!', 'success');
              }
            };
            headerCard.appendChild(btnDelete);
            card.appendChild(headerCard);
            
            const grid = document.createElement('div');
            grid.className = 'grid grid-cols-1 md:grid-cols-2 gap-4';

            for (const key in item) {
              if (key === 'packages') continue;

              const wrap = document.createElement('div');
              const isFullWidth = key === 'description' || key === 'text' || key === 'image' || key === 'url' || key.toLowerCase().includes('url') || Array.isArray(item[key]);
              wrap.className = isFullWidth ? 'md:col-span-2' : '';

              const label = document.createElement('label');
              label.className = 'block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1';
              label.textContent = key === 'slug' ? 'Slug (Contoh: tour-baru tanpa spasi)' : key;

              let input: any;

              if (Array.isArray(item[key])) {
                input = document.createElement('textarea');
                input.className = 'w-full border border-gray-300 rounded-lg p-3 text-sm focus:ring-2 focus:ring-emerald-500 outline-none min-h-[100px] font-mono';
                input.value = item[key].join('\n');
                
                input.addEventListener('input', (e: Event) => {
                  const target = e.target as HTMLTextAreaElement;
                  currentData[index][key] = target.value.split('\n');
                });
              } else if (typeof item[key] === 'string' && (item[key].length > 50 || key === 'description' || key === 'text')) {
                input = document.createElement('textarea');
                input.className = 'w-full border border-gray-300 rounded-lg p-3 text-sm focus:ring-2 focus:ring-emerald-500 outline-none min-h-[100px]';
                input.value = item[key];
                
                input.addEventListener('input', (e: Event) => {
                  const target = e.target as HTMLTextAreaElement;
                  currentData[index][key] = target.value;
                });
              } else {
                input = document.createElement('input');
                input.type = typeof item[key] === 'number' ? 'number' : 'text';
                input.className = 'w-full border border-gray-300 rounded-lg p-3 text-sm focus:ring-2 focus:ring-emerald-500 outline-none';
                input.value = item[key];

                input.addEventListener('input', (e: Event) => {
                  const target = e.target as HTMLInputElement;
                  let val: any = target.value;
                  if (input.type === 'number') val = Number(val);
                  currentData[index][key] = val;

                  if (currentTab === 'packages' && key === 'slug') {
                    currentData[index]['moreInfoUrl'] = `/${val}`;
                  }
                });
              }

              wrap.appendChild(label);
              wrap.appendChild(input);
              
              if (key === 'image' || key === 'url' || key.toLowerCase().includes('url')) {
                 const preview = document.createElement('img');
                 preview.src = item[key];
                 preview.className = 'mt-2 h-24 rounded object-cover border';
                 preview.onerror = () => preview.style.display = 'none';
                 wrap.appendChild(preview);
                 
                 input.addEventListener('input', (e: Event) => {
                    const target = e.target as HTMLInputElement;
                    preview.src = target.value;
                    preview.style.display = 'block';
                 });
              }

              grid.appendChild(wrap);
            }
            card.appendChild(grid);
            formContainer.appendChild(card);
          });
        } else {
          // Object tunggal (Settings & About)
          const card = document.createElement('div');
          card.className = 'bg-white p-6 rounded-xl shadow-sm border border-gray-200';
          const grid = document.createElement('div');
          grid.className = 'grid grid-cols-1 md:grid-cols-2 gap-4';

          for (const key in data) {
            const wrap = document.createElement('div');
            const isFullWidth = key === 'description' || key === 'subtitle' || key === 'image' || key === 'url' || key === 'heroSubtitle';
            wrap.className = isFullWidth ? 'md:col-span-2' : '';

            const label = document.createElement('label');
            label.className = 'block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1';
            label.textContent = key;

            let input: any;
            if (Array.isArray(data[key])) {
              input = document.createElement('textarea');
              input.className = 'w-full border border-gray-300 rounded-lg p-3 text-sm focus:ring-2 focus:ring-emerald-500 outline-none min-h-[100px] font-mono';
              input.value = data[key].join('\n');
              input.addEventListener('input', (e: Event) => {
                const target = e.target as HTMLTextAreaElement;
                currentData[key] = target.value.split('\n');
              });
            } else if (typeof data[key] === 'string' && data[key].length > 50) {
              input = document.createElement('textarea');
              input.className = 'w-full border border-gray-300 rounded-lg p-3 text-sm focus:ring-2 focus:ring-emerald-500 outline-none min-h-[100px]';
              input.value = data[key];
              input.addEventListener('input', (e: Event) => {
                const target = e.target as HTMLTextAreaElement;
                currentData[key] = target.value;
              });
            } else {
              input = document.createElement('input');
              input.type = typeof data[key] === 'number' ? 'number' : 'text';
              input.className = 'w-full border border-gray-300 rounded-lg p-3 text-sm focus:ring-2 focus:ring-emerald-500 outline-none';
              input.value = data[key];
              input.addEventListener('input', (e: Event) => {
                const target = e.target as HTMLInputElement;
                let val: any = target.value;
                if (input.type === 'number') val = Number(val);
                currentData[key] = val;
              });
            }

            wrap.appendChild(label);
            wrap.appendChild(input);

            if (key === 'image' || key === 'url' || key.toLowerCase().includes('url')) {
               const preview = document.createElement('img');
               preview.src = data[key];
               preview.className = 'mt-2 h-24 rounded object-cover border';
               preview.onerror = () => preview.style.display = 'none';
               wrap.appendChild(preview);
               
               input.addEventListener('input', (e: Event) => {
                  const target = e.target as HTMLInputElement;
                  preview.src = target.value;
                  preview.style.display = 'block';
               });
            }

            grid.appendChild(wrap);
          }
          card.appendChild(grid);
          formContainer.appendChild(card);
        }
      }

      btnAdd.addEventListener('click', () => {
        if (!Array.isArray(currentData)) return;

        if (currentTab === 'packages') {
          const newPackage = {
            slug: "paket-wisata-baru",
            title: "PAKET WISATA BARU",
            image: "https://images.unsplash.com/photo-1541625602330-2277a4c46182?q=80&w=800&auto=format&fit=crop",
            itinerary: ["08:00 - Penjemputan di hotel"],
            whatToBring: ["Pakaian ganti"],
            moreInfoUrl: "/paket-wisata-baru",
            packages: [
              {
                type: "Single",
                originalPrice: "IDR 500K",
                discountedPrice: "350K",
                details: ["Fasilitas 1 orang"],
                bookNowUrl: "https://wa.me/6281337626262"
              }
            ]
          };
          currentData.push(newPackage);
        } else if (currentTab === 'gallery') {
          currentData.push({ id: Date.now(), url: "https://images.unsplash.com/...", alt: "Foto baru" });
        } else {
          if (currentData.length === 0) {
            currentData.push({ title: "Item Baru", description: "Deskripsi..." });
          } else {
            const template = JSON.parse(JSON.stringify(currentData[0]));
            for (const key in template) {
              if (typeof template[key] === 'string') template[key] = 'Teks baru...';
              else if (typeof template[key] === 'number') template[key] = 0;
              else if (Array.isArray(template[key])) template[key] = ['Poin 1'];
            }
            currentData.push(template);
          }
        }

        renderForm(currentData);
        showStatus('Item baru berhasil ditambahkan! Jangan lupa klik Simpan.', 'success');
      });

      async function loadData(tab: string) {
        currentTab = tab;
        pageTitle.textContent = `Manage ${tab.charAt(0).toUpperCase() + tab.slice(1)}`;
        formContainer.innerHTML = '<p class="text-gray-500 font-medium animate-pulse">Memuat data form...</p>';
        btnSave.disabled = true;
        
        try {
          // Pemetaan file JSON fisik langsung agar aman di GitHub Pages (Static)
          let jsonFile = tab;
          if (tab === 'packages') jsonFile = 'singlepackage';
          if (tab === 'settings') jsonFile = 'siteSettings';

          // Mendeteksi base path otomatis (lokal / github pages)
          const isGitHub = window.location.hostname.includes('github.io');
          const basePath = isGitHub ? '/jayaprana_adventure' : '';
          const res = await fetch(`${basePath}/src/data/${jsonFile}.json?t=${Date.now()}`);
          
          if (!res.ok) throw new Error('Gagal mengambil file JSON');
          const data = await res.json();
          renderForm(data);
        } catch (err) {
          formContainer.innerHTML = `<p class="text-red-500">Gagal memuat data untuk tab ini. Pastikan file JSON tersedia.</p>`;
        } finally {
          btnSave.disabled = false;
        }
      }

      tabs.forEach(btn => {
        btn.addEventListener('click', (e: Event) => {
          tabs.forEach(t => {
            t.classList.remove('bg-emerald-600', 'text-white');
            t.classList.add('hover:bg-slate-700', 'text-white');
          });
          
          const target = e.target as HTMLButtonElement;
          target.classList.add('bg-emerald-600', 'text-white');
          target.classList.remove('hover:bg-slate-700');
          
          if (target.dataset.tab) {
            loadData(target.dataset.tab);
          }
        });
      });

      btnSave.addEventListener('click', async () => {
        const token = tokenInput.value;
        if (!token) return showStatus('Error: Token GitHub wajib diisi!', 'error');
        if (!currentData) return showStatus('Data masih kosong.', 'error');

        btnSave.textContent = "⏳ Menyimpan ke GitHub...";
        btnSave.disabled = true;

        let targetFileJson = currentTab;
        if (currentTab === 'packages') targetFileJson = 'singlepackage';
        if (currentTab === 'settings') targetFileJson = 'siteSettings';

        const filePath = `src/data/${targetFileJson}.json`; 
        const apiUrl = `https://api.github.com/repos/${githubOwner}/${githubRepo}/contents/${filePath}`;

        try {
          const getRes = await fetch(apiUrl, {
            headers: { 'Authorization': `token ${token}` }
          });
          
          if (!getRes.ok && getRes.status !== 404) throw new Error('Gagal mengecek file di GitHub. Cek Token!');
          
          let sha = '';
          if (getRes.ok) {
            const fileData = await getRes.json();
            sha = fileData.sha;
          }

          const jsonString = JSON.stringify(currentData, null, 2);
          const base64Content = btoa(unescape(encodeURIComponent(jsonString)));

          const putRes = await fetch(apiUrl, {
            method: 'PUT',
            headers: {
              'Authorization': `token ${token}`,
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              message: `Update ${currentTab} via Admin Dashboard`,
              content: base64Content,
              sha: sha || undefined
            })
          });

          if (!putRes.ok) {
            const errData = await putRes.json();
            throw new Error(errData.message || 'Gagal menyimpan file.');
          }

          showStatus(`Sukses! Data ${currentTab} berhasil disimpan ke GitHub. Tunggu 1-2 menit proses build GitHub Actions selesai.`, 'success');

        } catch (err: any) { 
          showStatus(err.message, 'error');
        } finally {
          btnSave.textContent = "💾 Simpan Perubahan ke GitHub";
          btnSave.disabled = false;
        }
      });

      loadData(currentTab);
    </script>
  </body>
</html>