---
import Header from '../components/header.jsx';
import Footer from '../components/footer.jsx';
import FloatingWA from '../components/FloatingWA.astro'; 
import siteSettingsData from '../data/siteSettings.json'; 

export interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  image?: string; 
}

const { title, description, keywords, image = '/default-og.jpg' } = Astro.props;
const settings = siteSettingsData;

// --- KONSTRUKSI URL YANG LEBIH AMAN UNTUK GITHUB PAGES ---
// Mengambil base URL dari astro.config.mjs (cth: https://adiarthaputra.github.io/jayaprana_adventure/)
const baseUrl = Astro.site 
  ? new URL(import.meta.env.BASE_URL, Astro.site) 
  : new URL(import.meta.env.BASE_URL, Astro.url.origin);

// Membersihkan path halaman saat ini agar tersambung sempurna dengan baseUrl
const currentPath = Astro.url.pathname.replace(import.meta.env.BASE_URL, '').replace(/^\//, '');
const canonicalURL = new URL(currentPath, baseUrl);

const getAbsoluteImageUrl = (img?: string) => {
  if (!img) return null;
  if (img.startsWith('http://') || img.startsWith('https://')) {
    return new URL(img);
  }
  // Menghapus garis miring di awal string gambar agar path tidak menimpa nama repositori
  return new URL(img.replace(/^\//, ''), baseUrl);
};

const socialImageURL = getAbsoluteImageUrl(image);
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <title>{title ?? 'Bali Adventure Explorer'}</title>
    {description && <meta name="description" content={description} />}
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="author" content="Bali Adventure Explorer" />
    <link rel="canonical" href={canonicalURL.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {/* --- OPEN GRAPH UNTUK WHATSAPP, FACEBOOK, DLL --- */}
    <meta property="og:title" content={title ?? 'Bali Adventure Explorer'} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    {socialImageURL && <meta property="og:image" content={socialImageURL.href} />}
    {socialImageURL && <meta property="og:image:alt" content={`Gambar untuk ${title ?? 'Bali Adventure Explorer'}`} />}
    <meta property="og:site_name" content="Bali Adventure Explorer" />
    <meta property="og:locale" content="en_US" />

    {/* --- TWITTER CARDS --- */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? 'Bali Adventure Explorer'} />
    {description && <meta name="twitter:description" content={description} />}
    {socialImageURL && <meta name="twitter:image" content={socialImageURL.href} />}

    <link rel="stylesheet" href="/styles/global.css" />
  </head>
  <body class="bg-primary-white text-primary-dark min-h-screen relative flex flex-col">
    
    {/* ===== STICKY NAVBAR (SEKARANG SUPPORT MOBILE!) ===== */}
    <nav class="fixed w-full z-50 bg-white/90 backdrop-blur-md shadow-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16 items-center">
          <div class="flex-shrink-0 flex items-center">
            <a href="/" class="text-2xl font-bold text-emerald-700">Bali Explorer</a>
          </div>
          
          {/* MENU DESKTOP (Tersembunyi di HP) */}
          <div class="hidden md:flex space-x-8">
            <a href="/#home" class="text-gray-700 hover:text-emerald-600 font-medium transition">Home</a>
            <a href="/#about" class="text-gray-700 hover:text-emerald-600 font-medium transition">About Us</a>
            <a href="/#package" class="text-gray-700 hover:text-emerald-600 font-medium transition">Packages</a>
            <a href="/#faq" class="text-gray-700 hover:text-emerald-600 font-medium transition">FAQ</a>
          </div>

          {/* TOMBOL HAMBURGER MOBILE (Hanya muncul di HP) */}
          <div class="flex md:hidden items-center">
            <button id="mobile-menu-btn" class="text-gray-700 hover:text-emerald-600 focus:outline-none p-2">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
              </svg>
            </button>
          </div>
        </div>
      </div>

      {/* DROPDOWN MENU MOBILE (Tersembunyi default) */}
      <div id="mobile-menu" class="hidden md:hidden bg-white border-t border-gray-100 shadow-lg absolute w-full left-0">
        <div class="px-4 pt-2 pb-4 space-y-1">
          <a href="/#home" class="block px-3 py-3 rounded-md text-base font-medium text-gray-700 hover:text-emerald-600 hover:bg-emerald-50">Home</a>
          <a href="/#about" class="block px-3 py-3 rounded-md text-base font-medium text-gray-700 hover:text-emerald-600 hover:bg-emerald-50">About Us</a>
          <a href="/#package" class="block px-3 py-3 rounded-md text-base font-medium text-gray-700 hover:text-emerald-600 hover:bg-emerald-50">Packages</a>
          <a href="/#faq" class="block px-3 py-3 rounded-md text-base font-medium text-gray-700 hover:text-emerald-600 hover:bg-emerald-50">FAQ</a>
        </div>
      </div>
    </nav>

    <main class="pt-16 container mx-auto p-4 flex-grow">
      <slot />
    </main>
    
    <FloatingWA />
    
    {/* ===== COMPREHENSIVE FOOTER ===== */}
    <footer class="bg-gray-900 text-gray-300 py-12 px-4 mt-20">
      <div class="container mx-auto grid grid-cols-1 md:grid-cols-3 gap-8 max-w-7xl">
        <div>
          <h4 class="text-xl font-bold text-white mb-4">Bali Adventure Explorer</h4>
          <p class="text-sm text-gray-400 mb-4">Delivering the ultimate outdoor experiences in Bali. Safe, thrilling, and unforgettable.</p>
          <div class="flex space-x-4">
            <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/b/b5/PayPal.svg/2560px-PayPal.svg.png" alt="PayPal" class="h-6 opacity-70 bg-white px-2 py-1 rounded" />
            <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/5/5e/Visa_Inc._logo.svg/2560px-Visa_Inc._logo.svg.png" alt="Visa" class="h-6 opacity-70 bg-white px-2 py-1 rounded" />
          </div>
        </div>
        <div>
          <h4 class="text-xl font-bold text-white mb-4">Quick Links</h4>
          <ul class="space-y-2 text-sm">
            <li><a href="/#about" class="hover:text-emerald-400 transition">About Us</a></li>
            <li><a href="/#package" class="hover:text-emerald-400 transition">Our Tours</a></li>
            <li><a href="/#faq" class="hover:text-emerald-400 transition">FAQ</a></li>
            <li><a href="#" class="hover:text-emerald-400 transition">Terms & Conditions</a></li>
          </ul>
        </div>
        <div>
          <h4 class="text-xl font-bold text-white mb-4">Contact Info</h4>
          <ul class="space-y-2 text-sm">
            <li class="flex items-start">
              <span class="mr-2">📍</span> <span class="leading-relaxed">{settings.address}</span>
            </li>
            <li class="flex items-center">
              <span class="mr-2">📞</span> <a href={`https://wa.me/${settings.whatsappNumber}`} target="_blank" class="hover:text-emerald-400 transition">+{settings.whatsappNumber}</a>
            </li>
            <li class="flex items-center">
              <span class="mr-2">✉️</span> <a href={`mailto:${settings.email}`} class="hover:text-emerald-400 transition">{settings.email}</a>
            </li>
          </ul>
        </div>
      </div>
      <div class="border-t border-gray-800 mt-8 pt-8 text-center text-sm text-gray-500">
        &copy; {new Date().getFullYear()} Bali Adventure Explorer. All rights reserved.
      </div>
    </footer>

    {/* ===== SCRIPT MENU MOBILE ===== */}
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const btn = document.getElementById('mobile-menu-btn');
        const menu = document.getElementById('mobile-menu');
        
        if (btn && menu) {
          btn.addEventListener('click', () => {
            menu.classList.toggle('hidden');
          });
          
          const links = menu.querySelectorAll('a');
          links.forEach(link => {
            link.addEventListener('click', () => {
              menu.classList.add('hidden');
            });
          });
        }
      });
    </script>
  </body>
</html>