---
import Header from '../components/header.jsx';
import Footer from '../components/footer.jsx';
import FloatingWA from '../components/FloatingWA.astro'; 
import siteSettingsData from '../data/siteSettings.json'; 

export interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  image?: string; 
}

interface SiteSettings {
  whatsappNumber: string;
  email: string;
  address?: string;
  [key: string]: any;
}

const { title, description, keywords, image = '/default-og.jpg' } = Astro.props;
const settings = siteSettingsData as SiteSettings;

// --- KONSTRUKSI URL YANG LEBIH AMAN UNTUK GITHUB PAGES ---
const baseUrl = Astro.site 
  ? new URL(import.meta.env.BASE_URL, Astro.site) 
  : new URL(import.meta.env.BASE_URL, Astro.url.origin);

const currentPath = Astro.url.pathname.replace(import.meta.env.BASE_URL, '').replace(/^\//, '');
const canonicalURL = new URL(currentPath, baseUrl);

const getAbsoluteImageUrl = (img?: string) => {
  if (!img) return null;
  if (img.startsWith('http://') || img.startsWith('https://')) {
    return new URL(img);
  }
  return new URL(img.replace(/^\//, ''), baseUrl);
};

const socialImageURL = getAbsoluteImageUrl(image);

// Helper agar link menu /#home aman dan tidak keluar dari sub-folder GitHub Pages
const basePath = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;
---

<!DOCTYPE html>
<!-- Tambahkan scroll-pt-20 agar saat auto-scroll, konten tidak tertutup header -->
<html lang="en" class="scroll-smooth scroll-pt-20">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    
    <title>{title ?? 'Bali Adventure Explorer'}</title>
    {description && <meta name="description" content={description} />}
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="author" content="Bali Adventure Explorer" />
    <link rel="canonical" href={canonicalURL.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- OPEN GRAPH UNTUK WHATSAPP, FACEBOOK, DLL -->
    <meta property="og:title" content={title ?? 'Bali Adventure Explorer'} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    {socialImageURL && <meta property="og:image" content={socialImageURL.href} />}
    {socialImageURL && <meta property="og:image:alt" content={`Gambar untuk ${title ?? 'Bali Adventure Explorer'}`} />}
    <meta property="og:site_name" content="Bali Adventure Explorer" />
    <meta property="og:locale" content="en_US" />

    <!-- TWITTER CARDS -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? 'Bali Adventure Explorer'} />
    {description && <meta name="twitter:description" content={description} />}
    {socialImageURL && <meta name="twitter:image" content={socialImageURL.href} />}

    <link rel="stylesheet" href="/styles/global.css" />
  </head>
  
  <body class="bg-primary-white text-primary-dark min-h-screen relative flex flex-col overflow-x-hidden">
    
    <!-- STICKY NAVBAR -->
    <nav class="fixed w-full z-50 bg-white/95 backdrop-blur-md shadow-sm border-b border-gray-100">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16 items-center">
          <div class="flex-shrink-0 flex items-center">
            <a href={`${basePath}/`} class="text-xl md:text-2xl font-bold text-emerald-700 tracking-tight">Bali Explorer</a>
          </div>
          
          <!-- MENU DESKTOP -->
          <div class="hidden md:flex space-x-8 items-center">
            <a href={`${basePath}/#home`} class="text-gray-600 hover:text-emerald-600 font-medium transition">Home</a>
            <a href={`${basePath}/#about`} class="text-gray-600 hover:text-emerald-600 font-medium transition">About Us</a>
            <a href={`${basePath}/#package`} class="text-gray-600 hover:text-emerald-600 font-medium transition">Packages</a>
            <a href={`${basePath}/#faq`} class="text-gray-600 hover:text-emerald-600 font-medium transition">FAQ</a>
            <a href={`https://wa.me/${settings.whatsappNumber}`} target="_blank" class="px-5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold rounded-full shadow-sm transition transform hover:-translate-y-0.5">Book Now</a>
          </div>

          <!-- TOMBOL HAMBURGER MOBILE -->
          <div class="flex md:hidden items-center">
            <button id="mobile-menu-btn" aria-label="Toggle Menu" class="text-gray-600 hover:text-emerald-600 focus:outline-none p-2 bg-gray-50 rounded-lg">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
              </svg>
            </button>
          </div>
        </div>
      </div>

      <!-- DROPDOWN MENU MOBILE -->
      <div id="mobile-menu" class="hidden md:hidden bg-white border-t border-gray-100 shadow-xl absolute w-full left-0 origin-top transition-all duration-300">
        <div class="px-4 py-3 space-y-2 max-h-[80vh] overflow-y-auto">
          <a href={`${basePath}/#home`} class="block px-4 py-3 rounded-xl text-base font-medium text-gray-700 hover:text-emerald-700 hover:bg-emerald-50 transition">🏠 Home</a>
          <a href={`${basePath}/#about`} class="block px-4 py-3 rounded-xl text-base font-medium text-gray-700 hover:text-emerald-700 hover:bg-emerald-50 transition">ℹ️ About Us</a>
          <a href={`${basePath}/#package`} class="block px-4 py-3 rounded-xl text-base font-medium text-gray-700 hover:text-emerald-700 hover:bg-emerald-50 transition">📦 Packages</a>
          <a href={`${basePath}/#faq`} class="block px-4 py-3 rounded-xl text-base font-medium text-gray-700 hover:text-emerald-700 hover:bg-emerald-50 transition">❓ FAQ</a>
          <div class="pt-2 pb-1 border-t border-gray-100 mt-2">
            <a href={`https://wa.me/${settings.whatsappNumber}`} target="_blank" class="block text-center px-4 py-3 rounded-xl text-base font-bold text-white bg-orange-500 hover:bg-orange-600 transition shadow-md">Book via WhatsApp</a>
          </div>
        </div>
      </div>
    </nav>

    <!-- MAIN CONTENT -->
    <main class="pt-16 flex-grow w-full">
      <slot />
    </main>
    
    <FloatingWA />
    
    <!-- COMPREHENSIVE FOOTER -->
    <footer class="bg-slate-900 text-gray-300 py-12 md:py-16 px-6 mt-16 border-t-4 border-emerald-600">
      <div class="container mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10 max-w-7xl">
        <div>
          <h4 class="text-2xl font-bold text-white mb-4">Bali Adventure Explorer</h4>
          <p class="text-sm md:text-base text-gray-400 mb-6 leading-relaxed">Delivering the ultimate outdoor experiences in Bali. Safe, thrilling, and unforgettable.</p>
          <div class="flex space-x-3">
            <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/b/b5/PayPal.svg/2560px-PayPal.svg.png" alt="PayPal" class="h-7 bg-white px-2 py-1 rounded shadow-sm" />
            <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/5/5e/Visa_Inc._logo.svg/2560px-Visa_Inc._logo.svg.png" alt="Visa" class="h-7 bg-white px-2 py-1 rounded shadow-sm" />
          </div>
        </div>
        <div>
          <h4 class="text-xl font-bold text-white mb-4">Quick Links</h4>
          <ul class="space-y-3 text-sm md:text-base">
            <li><a href={`${basePath}/#about`} class="hover:text-emerald-400 transition flex items-center gap-2"><span class="text-emerald-600">▸</span> About Us</a></li>
            <li><a href={`${basePath}/#package`} class="hover:text-emerald-400 transition flex items-center gap-2"><span class="text-emerald-600">▸</span> Our Tours</a></li>
            <li><a href={`${basePath}/#faq`} class="hover:text-emerald-400 transition flex items-center gap-2"><span class="text-emerald-600">▸</span> FAQ</a></li>
          </ul>
        </div>
        <div>
          <h4 class="text-xl font-bold text-white mb-4">Contact Info</h4>
          <ul class="space-y-4 text-sm md:text-base">
            <li class="flex items-start gap-3">
              <span class="text-xl shrink-0 mt-0.5">📍</span> 
              <span class="leading-relaxed text-gray-400">{settings.address}</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="text-xl shrink-0">📞</span> 
              <a href={`https://wa.me/${settings.whatsappNumber}`} target="_blank" class="hover:text-emerald-400 transition text-gray-400">+{settings.whatsappNumber}</a>
            </li>
            <li class="flex items-center gap-3 break-all">
              <span class="text-xl shrink-0">✉️</span> 
              <a href={`mailto:${settings.email}`} class="hover:text-emerald-400 transition text-gray-400">{settings.email}</a>
            </li>
          </ul>
        </div>
      </div>
      <div class="border-t border-slate-800 mt-10 pt-8 text-center text-sm text-slate-500 font-medium">
        &copy; {new Date().getFullYear()} Bali Adventure Explorer. All rights reserved.
      </div>
    </footer>

    <!-- SCRIPT MENU MOBILE -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const btn = document.getElementById('mobile-menu-btn');
        const menu = document.getElementById('mobile-menu');
        
        if (btn && menu) {
          btn.addEventListener('click', () => {
            menu.classList.toggle('hidden');
          });
          
          const links = menu.querySelectorAll('a');
          links.forEach(link => {
            link.addEventListener('click', () => {
              menu.classList.add('hidden');
            });
          });
        }
      });
    </script>
  </body>
</html>